FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 DONEPROOF_DB=/data/doneproof.db PLAYWRIGHT_BROWSERS_PATH=/opt/chromium
WORKDIR /app
RUN groupadd --system doneproof && useradd --system --gid doneproof --create-home doneproof
COPY pyproject.toml README.md ./
COPY doneproof ./doneproof
RUN pip install --no-cache-dir '.[browser]' && python -m playwright install --with-deps --only-shell chromium \
    && mkdir -p /data && chown -R doneproof:doneproof /data /app
USER doneproof
VOLUME ["/data"]
CMD ["python", "-m", "doneproof.worker"]
