# Runtime
DONEPROOF_ENV=development
DONEPROOF_DB=./data/doneproof.db
DONEPROOF_VERIFICATION_TIMEOUT_SECONDS=15

# Durable persistence. Required for production. Vercel/Neon can inject this automatically.
# Example: postgresql://user:password@host/database?sslmode=require
DATABASE_URL=

# Workspace authentication. JSON object: API key -> tenant id.
# Required for production readiness.
DONEPROOF_API_KEYS_JSON={}

# Stable Ed25519 seed. Base64 of exactly 32 random bytes.
# Generate once and store in a secret manager for production.
DONEPROOF_SIGNING_SEED_B64=

# Optional natural-language completion-contract compiler.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra

# GitHub. Public repositories work without a token; configure for private repos/rate limits.
GITHUB_TOKEN=

# Gmail. Use one default token or a per-tenant JSON mapping.
GMAIL_ACCESS_TOKEN=
DONEPROOF_GMAIL_TOKENS_JSON={}

# Trusted webhook evidence sources.
# Example: {"erp":{"tenant":"acme","secret":"replace-me"}}
DONEPROOF_WEBHOOK_SOURCES_JSON={}
DONEPROOF_WEBHOOK_MAX_SKEW_SECONDS=600

# Optional comma-separated browser origins for API calls.
DONEPROOF_CORS_ORIGINS=

# Maximum request/webhook body size in bytes (default 1 MiB).
DONEPROOF_MAX_BODY_BYTES=1048576

# Pilot traffic controls (per API key / workspace process)
DONEPROOF_REQUESTS_PER_MINUTE=120
DONEPROOF_MAX_BATCH_SIZE=25
