# Runtime
DONEPROOF_ENV=development
DONEPROOF_DB=./data/doneproof.db
DONEPROOF_VERIFICATION_TIMEOUT_SECONDS=15

# Durable persistence. Required for production. Vercel/Neon can inject this automatically.
# Example: postgresql://user:password@host/database?sslmode=require
DATABASE_URL=

# Workspace authentication. JSON object: API key -> tenant id.
# Required for production readiness.
DONEPROOF_API_KEYS_JSON={}

# Stable Ed25519 seed. Base64 of exactly 32 random bytes.
# Generate once and store in a secret manager for production.
DONEPROOF_SIGNING_SEED_B64=

# Optional natural-language completion-contract compiler.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra

# Managed onboarding. Use a fixed public HTTPS origin, never a request-derived callback URL.
DONEPROOF_PUBLIC_URL=
# Separate trusted operator keys, NOT executor/verification keys. JSON: key -> tenant id.
DONEPROOF_CONNECTION_ADMIN_KEYS_JSON={}
# JSON: key id -> base64 of exactly 32 random bytes. Separate from receipt signing keys.
DONEPROOF_CONNECTION_ENCRYPTION_KEYS_JSON={}
DONEPROOF_CONNECTION_ACTIVE_KEY=
DONEPROOF_GOOGLE_CLIENT_ID=
DONEPROOF_GOOGLE_CLIENT_SECRET=
# GitHub App: read-only Issues, Pull requests and Metadata; expiring user access tokens.
DONEPROOF_GITHUB_CLIENT_ID=
DONEPROOF_GITHUB_CLIENT_SECRET=
DONEPROOF_GITHUB_APP_SLUG=

# Deprecated tokens are imported ONCE into encrypted, tenant-scoped connections.
# Encryption keys above are required for import. Remove these after validating migration.
# Global tokens in multi-tenant deployments require an explicit tenant; never shared at runtime.
DONEPROOF_LEGACY_CONNECTION_TENANT=
# Public GitHub repositories continue to work anonymously when no connection exists.
GITHUB_TOKEN=

# Existing per-tenant Gmail configuration is migrated without changing tenant ownership.
GMAIL_ACCESS_TOKEN=
DONEPROOF_GMAIL_TOKENS_JSON={}

# Trusted webhook evidence sources.
# Example: {"erp":{"tenant":"acme","secret":"replace-me"}}
DONEPROOF_WEBHOOK_SOURCES_JSON={}
DONEPROOF_WEBHOOK_MAX_SKEW_SECONDS=600

# Optional comma-separated browser origins for API calls.
DONEPROOF_CORS_ORIGINS=

# Maximum request/webhook body size in bytes (default 1 MiB).
DONEPROOF_MAX_BODY_BYTES=1048576

# Pilot traffic controls (per API key / workspace process)
DONEPROOF_REQUESTS_PER_MINUTE=120
DONEPROOF_MAX_BATCH_SIZE=25
