# Optional: only required for POST /v1/contracts/compile
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra

# Optional: increases GitHub REST rate limit and permits private repos.
GITHUB_TOKEN=

# Persistence
DONEPROOF_DB=./doneproof.db

# Optional HMAC key for tamper-evident verification receipts.
# In production use a secret manager and rotate keys.
DONEPROOF_RECEIPT_KEY=dev-only-change-me
