{
  "contract": {
    "task": "Confirm issue #1 in octocat/Hello-World exists and is open",
    "postconditions": [
      {
        "id": "p1",
        "description": "Issue #1 exists",
        "provider": "github",
        "selector": {"repo": "octocat/Hello-World", "kind": "issue", "number": 1},
        "predicate": {"op": "exists", "path": "number", "expected": null},
        "required": true
      },
      {
        "id": "p2",
        "description": "Issue #1 is open",
        "provider": "github",
        "selector": {"repo": "octocat/Hello-World", "kind": "issue", "number": 1},
        "predicate": {"op": "eq", "path": "state", "expected": "open"},
        "required": true
      }
    ]
  }
}
